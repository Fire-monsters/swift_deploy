# GENERATED BY swiftdeploy — DO NOT EDIT MANUALLY

networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}

volumes:
  {{ services.log_volume }}:

services:

  app:
    image: {{ services.image }}
    restart: {{ services.restart_policy }}
    environment:
      - MODE={{ services.mode }}
      - APP_VERSION={{ services.version }}
      - APP_PORT={{ services.port }}
    networks:
      - {{ network.name }}
    volumes:
      - {{ services.log_volume }}:/app/logs
    # Note: port NOT exposed directly (all traffic through nginx)
    cap_drop:
      - ALL              # Drop all Linux capabilities (security)
    cap_add:
      - NET_BIND_SERVICE # Only add back what's needed
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ services.port }}/healthz')"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 15s

  nginx:
    image: {{ nginx.image }}
    restart: {{ services.restart_policy }}
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    networks:
      - {{ network.name }}
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      app:
        condition: service_healthy