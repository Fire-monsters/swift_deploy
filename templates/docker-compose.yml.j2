# GENERATED BY swiftdeploy — DO NOT EDIT MANUALLY

networks:
  {{ network.name }}:
    driver: {{ network.driver_type }}

  # Internal-only network for OPA — isolated from nginx/public traffic
  opa-internal:
    driver: bridge # No external access — OPA is never public
  
volumes:
  {{ services.log_volume }}:

services:

  app:
    image: {{ services.image }}
    restart: {{ services.restart_policy }}
    environment:
      - MODE={{ services.mode }}
      - APP_VERSION={{ services.version }}
      - APP_PORT={{ services.port }}
    networks:
      - {{ network.name }}
      - opa-internal
    volumes:
      - {{ services.log_volume }}:/app/logs
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ services.port }}/healthz')"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 15s

  nginx:
    image: {{ nginx.image }}
    restart: {{ services.restart_policy }}
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    networks:
      - {{ network.name }}
      # nginx is NOT on opa-internal — cannot reach OPA
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      app:
        condition: service_healthy

  opa:
    image: {{ opa.image }}
    restart: {{ services.restart_policy }}
    ports:
      - "{{ opa.port }}:{{ opa.port }}"
    networks:   
      - opa-internal
    volumes:
      - ./policies:/policies:ro
    command:
      - "run"
      - "--server"
      - "--addr=0.0.0.0:{{ opa.port }}"
      - "--log-level=error"
      - "/policies"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:{{ opa.port }}/health"]
      interval: 10s
      timeout: 5s
      retries: 6