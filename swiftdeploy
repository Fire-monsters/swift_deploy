def cmd_deploy():
    print_step("swiftdeploy deploy — bringing up the stack")
    manifest = load_manifest()
    opa_port = manifest["opa"]["port"]
    nginx_port = manifest["nginx"]["port"]

    # Generate configs
    cmd_init()

    # Start OPA first (needed for policy checks)
    print("\n🔐 Starting OPA policy engine...")
    run("docker compose up -d opa")
    time.sleep(5)  # Give OPA time to load policies

    # PRE-DEPLOY POLICY CHECK
    print_step("Pre-deploy policy check")
    try:
        host_stats = get_host_stats()
        print(f"  Host stats:")
        print(f"    Disk free:  {host_stats['disk_free_gb']}GB")
        print(f"    CPU load:   {host_stats['cpu_load']}")
        print(f"    Memory:     {host_stats['mem_percent']}%")

        checks = [{
            "name": "infrastructure",
            "package": "policy/infrastructure",
            "opa_port": opa_port,
            "input": host_stats
        }]

        passed = run_policy_checks(checks)
        if not passed:
            print("\n❌ Pre-deploy policy check FAILED — deployment blocked")
            print("   Fix the violations above and try again")
            # Record violation in audit trail
            append_history("deploy_blocked", {
                "reason": "policy_violation",
                "host_stats": host_stats
            })
            run("docker compose down", check=False)
            sys.exit(1)

        print("\n✅ Pre-deploy policy checks passed")

    except ImportError:
        print("⚠️  psutil not installed — skipping host stats check")
        print("   Install with: pip install psutil --break-system-packages")

    # Start app
    print("\n🚀 Starting app container...")
    run("docker compose up -d app")

    # Wait for health
    print("\n⏳ Waiting for health checks to pass...")
    timeout = 60
    start = time.time()

    while time.time() - start < timeout:
        health_result = run(
            "docker inspect --format='{{.State.Health.Status}}' "
            "$(docker compose ps -q app)",
            check=False
        )
        status = health_result.stdout.strip()
        elapsed = int(time.time() - start)
        print(f"  [{elapsed}s] Health status: {status}")

        if status == "healthy":
            print("\n  App is healthy — starting nginx...")
            run("docker compose up -d nginx")
            time.sleep(3)

            # Record successful deploy
            append_history("deploy_success", {
                "mode": manifest["services"]["mode"],
                "version": manifest["services"]["version"]
            })

            print("\n✅ Stack is up and healthy!")
            print(f"  → App (via nginx): http://localhost:{nginx_port}")
            print(f"  → Health check:    http://localhost:{nginx_port}/healthz")
            print(f"  → Metrics:         http://localhost:{nginx_port}/metrics")
            return

        time.sleep(5)

    print("❌ Health checks did not pass within 60 seconds")
    run("docker compose logs app", check=False)
    sys.exit(1)

