def cmd_audit():
    """
    Reads history.jsonl and generates audit_report.md
    """
    print_step("swiftdeploy audit — generating audit report")

    if not os.path.exists(HISTORY_FILE):
        print("❌ No history.jsonl found — run status first to build history")
        sys.exit(1)

    events = []
    with open(HISTORY_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if line:
                events.append(json.loads(line))

    if not events:
        print("❌ history.jsonl is empty")
        sys.exit(1)

    # Separate event types
    deploys = [e for e in events if "deploy" in e["event"]]
    promotes = [e for e in events if "promote" in e["event"]]
    violations = [e for e in events if "blocked" in e["event"]]
    scrapes = [e for e in events if e["event"] == "status_scrape"]

    # Build markdown report
    lines = []
    lines.append("# SwiftDeploy Audit Report")
    lines.append(f"\nGenerated: {datetime.datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S UTC')}")
    lines.append(f"\nTotal events recorded: {len(events)}")

    # Timeline table
    lines.append("\n## Timeline\n")
    lines.append("| Timestamp | Event | Details |")
    lines.append("|-----------|-------|---------|")

    for e in deploys + promotes:
        ts = e["timestamp"]
        event = e["event"]
        details = json.dumps(e.get("data", {}))
        lines.append(f"| {ts} | {event} | {details} |")

    # Violations section
    lines.append("\n## Policy Violations\n")
    if violations:
        lines.append("| Timestamp | Type | Reason |")
        lines.append("|-----------|------|--------|")
        for e in violations:
            ts = e["timestamp"]
            reason = e.get("data", {}).get("reason", "unknown")
            lines.append(f"| {ts} | {e['event']} | {reason} |")
    else:
        lines.append("_No policy violations recorded._")

    # Metrics summary from scrapes
    if scrapes:
        lines.append("\n## Metrics Summary\n")
        error_rates = [s["data"]["error_rate"] for s in scrapes]
        latencies = [s["data"]["p99_latency_ms"] for s in scrapes]
        lines.append(f"- Scrapes recorded: {len(scrapes)}")
        lines.append(f"- Avg error rate: {sum(error_rates)/len(error_rates)*100:.2f}%")
        lines.append(f"- Max P99 latency: {max(latencies):.0f}ms")
        lines.append(f"- Avg P99 latency: {sum(latencies)/len(latencies):.0f}ms")

        # Mode changes
        mode_changes = [
            s for i, s in enumerate(scrapes)
            if i == 0 or s["data"]["mode"] != scrapes[i-1]["data"]["mode"]
        ]
        if mode_changes:
            lines.append("\n### Mode Changes\n")
            lines.append("| Timestamp | Mode |")
            lines.append("|-----------|------|")
            for s in mode_changes:
                lines.append(f"| {s['timestamp']} | {s['data']['mode']} |")

    # Write report
    report = "\n".join(lines)
    with open("audit_report.md", "w") as f:
        f.write(report)

    print("✅ audit_report.md generated")
    print(f"   Events processed: {len(events)}")
    print(f"   Violations found: {len(violations)}")
    print(f"   View with: cat audit_report.md")

# ─────────────────────────────────────────
# SUBCOMMAND: teardown
# ─────────────────────────────────────────

def cmd_teardown(clean=False):
    print_step("swiftdeploy teardown — removing stack")
    run("docker compose down --volumes --remove-orphans")
    print("✅ Containers, networks and volumes removed")

    if clean:
        for f in ["nginx.conf", "docker-compose.yml"]:
            if os.path.exists(f):
                os.remove(f)
                print(f"✅ Deleted {f}")

    append_history("teardown", {"clean": clean})
    print("\n✅ Teardown complete")

# ─────────────────────────────────────────
# ENTRYPOINT
# ─────────────────────────────────────────

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    command = sys.argv[1]

    if command == "init":
        cmd_init()
    elif command == "validate":
        cmd_validate()
    elif command == "deploy":
        cmd_deploy()
    elif command == "promote":
        if len(sys.argv) < 3:
            print("❌ Usage: ./swiftdeploy promote [canary|stable]")
            sys.exit(1)
        cmd_promote(sys.argv[2])
    elif command == "status":
        cmd_status()
    elif command == "audit":
        cmd_audit()
    elif command == "teardown":
        clean = "--clean" in sys.argv
        cmd_teardown(clean)
    else:
        print(f"❌ Unknown command: {command}")
        print(__doc__)
        sys.exit(1)