#!/usr/bin/env python3
"""
swiftdeploy — CLI tool that manages the entire stack lifecycle
Usage:
  ./swiftdeploy init
  ./swiftdeploy validate
  ./swiftdeploy deploy
  ./swiftdeploy promote canary
  ./swiftdeploy promote stable
  ./swiftdeploy status
  ./swiftdeploy audit
  ./swiftdeploy teardown
  ./swiftdeploy teardown --clean
"""

import sys
import os
import subprocess
import socket
import json
import time
import re
import datetime
import threading
import yaml
from jinja2 import Template

# ─────────────────────────────────────────
# HELPERS
# ─────────────────────────────────────────

def load_manifest():
    with open("manifest.yaml", "r") as f:
        return yaml.safe_load(f)

def render_template(template_path, context):
    with open(template_path, "r") as f:
        template = Template(f.read())
    return template.render(**context)

def run(command, check=True):
    result = subprocess.run(
        command, shell=True,
        capture_output=True, text=True
    )
    if check and result.returncode != 0:
        print(f"❌ Command failed: {command}")
        print(result.stderr)
        sys.exit(1)
    return result

def print_step(msg):
    print(f"\n{'─'*50}")
    print(f"  {msg}")
    print(f"{'─'*50}")

# ─────────────────────────────────────────
# METRICS PARSER
# Reads raw Prometheus text and extracts values
# ─────────────────────────────────────────

def scrape_metrics(port):
    """
    Fetches /metrics and returns parsed dict.
    Returns None if unreachable.
    """
    try:
        import urllib.request
        url = f"http://localhost:{port}/metrics"
        with urllib.request.urlopen(url, timeout=5) as r:
            return r.read().decode()
    except Exception:
        return None

def parse_counter(metrics_text, name, labels=None):
    """Extract a counter value from Prometheus text"""
    if not metrics_text:
        return 0
    total = 0
    for line in metrics_text.splitlines():
        if line.startswith("#"):
            continue
        if not line.startswith(name):
            continue
        if labels:
            if all(f'{k}="{v}"' in line for k, v in labels.items()):
                val = float(line.split()[-1])
                total += val
        else:
            val = float(line.split()[-1])
            total += val
    return total

def calculate_error_rate(metrics_text):
    """
    Error rate = 5xx requests / total requests
    Returns float between 0 and 1
    """
    total = 0
    errors = 0
    if not metrics_text:
        return 0.0
    for line in metrics_text.splitlines():
        if line.startswith("#") or not line.startswith("http_requests_total"):
            continue
        val = float(line.split()[-1])
        total += val
        if '"5' in line:   # status_code starts with 5
            errors += val
    if total == 0:
        return 0.0
    return errors / total

def calculate_p99_latency(metrics_text):
    """
    P99 latency from histogram buckets.
    Finds the smallest bucket where count >= 99% of total.
    Returns milliseconds.
    """
    if not metrics_text:
        return 0.0

    buckets = []
    total_count = 0

    for line in metrics_text.splitlines():
        if line.startswith("#"):
            continue
        if "http_request_duration_seconds_bucket" not in line:
            continue
        le_match = re.search(r'le="([^"]+)"', line)
        if not le_match:
            continue
        le = le_match.group(1)
        val = float(line.split()[-1])
        if le == "+Inf":
            total_count = val
        else:
            buckets.append((float(le), val))

    if total_count == 0:
        return 0.0

    target = total_count * 0.99
    for le, count in sorted(buckets):
        if count >= target:
            return le * 1000  # convert seconds to ms

    return buckets[-1][0] * 1000 if buckets else 0.0

def get_host_stats():
    """Get disk, CPU, memory stats from the host"""
    import shutil
    import psutil

    disk = shutil.disk_usage("/")
    disk_free_gb = disk.free / (1024 ** 3)

    cpu_load = os.getloadavg()[0]  # 1-minute load average

    mem = psutil.virtual_memory()
    mem_percent = mem.percent

    return {
        "disk_free_gb": round(disk_free_gb, 2),
        "cpu_load": round(cpu_load, 2),
        "mem_percent": round(mem_percent, 1),
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z"
    }

# ─────────────────────────────────────────
# OPA POLICY ENGINE
# ─────────────────────────────────────────

def query_opa(opa_port, package, input_data):
    """
    Send input to OPA and get decision back.
    Returns dict with allow, violations, domain.
    Never crashes — returns error state if OPA unreachable.
    """
    import urllib.request
    import urllib.error

    url = f"http://localhost:{opa_port}/v1/data/{package}/decision"
    payload = json.dumps({"input": input_data}).encode()

    try:
        req = urllib.request.Request(
            url,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=5) as r:
            response = json.loads(r.read().decode())
            # OPA wraps result in {"result": {...}}
            return response.get("result", {})

    except urllib.error.URLError:
        # OPA is unreachable
        return {
            "allow": False,
            "violations": ["OPA is unreachable — cannot make policy decision"],
            "domain": package,
            "error": "opa_unreachable"
        }
    except urllib.error.HTTPError as e:
        # OPA returned an error (e.g. policy not found)
        return {
            "allow": False,
            "violations": [f"OPA returned HTTP {e.code} — check policy syntax"],
            "domain": package,
            "error": "opa_http_error"
        }
    except Exception as e:
        # Any other failure
        return {
            "allow": False,
            "violations": [f"Unexpected OPA error: {str(e)}"],
            "domain": package,
            "error": "opa_unknown_error"
        }

def run_policy_checks(checks):
    """
    Run multiple OPA policy checks.
    Each check is a dict: {name, package, input}
    Returns True if ALL pass, False if any fail.
    Prints clear pass/fail for each domain.
    """
    all_passed = True
    print("\n  Policy checks:")

    for check in checks:
        decision = query_opa(
            check["opa_port"],
            check["package"],
            check["input"]
        )

        allowed = decision.get("allow", False)
        violations = decision.get("violations", [])
        domain = decision.get("domain", check["package"])
        error = decision.get("error")

        if error == "opa_unreachable":
            print(f"  ⚠️  [{domain}] OPA unreachable — policy check skipped")
            print(f"      Warning: Proceeding without policy enforcement")
            # Don't block on OPA being down — warn but continue
            continue

        if allowed:
            print(f"  ✅ [{domain}] Policy check passed")
        else:
            print(f"  ❌ [{domain}] Policy check FAILED")
            for v in violations:
                print(f"      → {v}")
            all_passed = False

    return all_passed

# ─────────────────────────────────────────
# AUDIT TRAIL
# ─────────────────────────────────────────

HISTORY_FILE = "history.jsonl"

def append_history(event_type, data):
    """Append an event to history.jsonl for audit trail"""
    entry = {
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        "event": event_type,
        "data": data
    }
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")

# ─────────────────────────────────────────
# SUBCOMMAND: init
# ─────────────────────────────────────────

def cmd_init():
    print_step("swiftdeploy init — generating configs from manifest")
    manifest = load_manifest()

    nginx_conf = render_template("templates/nginx.conf.j2", manifest)
    with open("nginx.conf", "w") as f:
        f.write(nginx_conf)
    print("✅ Generated nginx.conf")

    compose = render_template("templates/docker-compose.yml.j2", manifest)
    with open("docker-compose.yml", "w") as f:
        f.write(compose)
    print("✅ Generated docker-compose.yml")

    # Ensure policies directory exists
    os.makedirs("policies", exist_ok=True)
    print("✅ Confirmed policies/ directory exists")
    print("\n✅ Init complete — configs generated from manifest.yaml")

# ─────────────────────────────────────────
# SUBCOMMAND: validate
# ─────────────────────────────────────────

def cmd_validate():
    print_step("swiftdeploy validate — running pre-flight checks")
    passed = 0
    failed = 0

    # CHECK 1: manifest.yaml valid
    try:
        manifest = load_manifest()
        print("✅ Check 1: manifest.yaml exists and is valid YAML")
        passed += 1
    except FileNotFoundError:
        print("❌ Check 1: manifest.yaml not found")
        sys.exit(1)
    except yaml.YAMLError as e:
        print(f"❌ Check 1: manifest.yaml is invalid YAML — {e}")
        sys.exit(1)

    # CHECK 2: Required fields
    required = [
        ("services.image", manifest.get("services", {}).get("image")),
        ("services.port",  manifest.get("services", {}).get("port")),
        ("nginx.image",    manifest.get("nginx", {}).get("image")),
        ("nginx.port",     manifest.get("nginx", {}).get("port")),
        ("network.name",   manifest.get("network", {}).get("name")),
        ("network.driver_type", manifest.get("network", {}).get("driver_type")),
        ("opa.image",      manifest.get("opa", {}).get("image")),
        ("opa.port",       manifest.get("opa", {}).get("port")),
    ]
    missing = [k for k, v in required if not v]
    if missing:
        print(f"❌ Check 2: Missing required fields: {missing}")
        failed += 1
    else:
        print("✅ Check 2: All required fields present")
        passed += 1

    # CHECK 3: Docker image exists
    image = manifest["services"]["image"]
    result = run(f"docker image inspect {image}", check=False)
    if result.returncode == 0:
        print(f"✅ Check 3: Docker image '{image}' exists locally")
        passed += 1
    else:
        print(f"❌ Check 3: Docker image '{image}' not found locally")
        print(f"   Run: docker build -t {image} ./app")
        failed += 1

    # CHECK 4: Nginx port available
    nginx_port = manifest["nginx"]["port"]
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(1)
    result_conn = sock.connect_ex(("localhost", nginx_port))
    sock.close()
    if result_conn == 0:
        print(f"❌ Check 4: Port {nginx_port} is already in use")
        failed += 1
    else:
        print(f"✅ Check 4: Port {nginx_port} is available")
        passed += 1

    # CHECK 5: nginx.conf syntax valid
    if os.path.exists("nginx.conf"):
        with open("nginx.conf", "r") as f:
            nginx_content = f.read()
        test_content = nginx_content.replace(
            f"server app:{manifest['services']['port']}",
            f"server 127.0.0.1:{manifest['services']['port']}"
        )
        with open("/tmp/nginx_test.conf", "w") as f:
            f.write(test_content)
        result = run(
            "docker run --rm "
            "-v /tmp/nginx_test.conf:/etc/nginx/conf.d/default.conf:ro "
            "nginx nginx -t",
            check=False
        )
        if result.returncode == 0:
            print("✅ Check 5: nginx.conf syntax is valid")
            passed += 1
        else:
            print("❌ Check 5: nginx.conf has syntax errors")
            print(result.stderr)
            failed += 1
    else:
        print("⚠️  Check 5: nginx.conf not found — run init first")
        failed += 1

    print(f"\n{'─'*50}")
    print(f"  Results: {passed} passed, {failed} failed")
    print(f"{'─'*50}")

    if failed > 0:
        sys.exit(1)

