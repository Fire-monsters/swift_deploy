# SUBCOMMAND: promote
# ─────────────────────────────────────────

def cmd_promote(target_mode):
    if target_mode not in ("canary", "stable"):
        print("❌ Usage: ./swiftdeploy promote [canary|stable]")
        sys.exit(1)

    print_step(f"swiftdeploy promote — switching to {target_mode} mode")
    manifest = load_manifest()
    opa_port = manifest["opa"]["port"]
    nginx_port = manifest["nginx"]["port"]

    # PRE-PROMOTE POLICY CHECK (only when promoting to canary)
    if target_mode == "canary":
        print_step("Pre-promote canary safety check")

        metrics_text = scrape_metrics(nginx_port)
        if metrics_text:
            error_rate = calculate_error_rate(metrics_text)
            p99_latency = calculate_p99_latency(metrics_text)

            print(f"  Current metrics:")
            print(f"    Error rate:   {error_rate*100:.2f}%")
            print(f"    P99 latency:  {p99_latency:.0f}ms")

            checks = [{
                "name": "canary",
                "package": "policy/canary",
                "opa_port": opa_port,
                "input": {
                    "error_rate": error_rate,
                    "p99_latency_ms": p99_latency,
                    "timestamp": datetime.datetime.utcnow().isoformat() + "Z"
                }
            }]

            passed = run_policy_checks(checks)
            if not passed:
                print("\n❌ Canary safety check FAILED — promotion blocked")
                append_history("promote_blocked", {
                    "target_mode": target_mode,
                    "error_rate": error_rate,
                    "p99_latency_ms": p99_latency
                })
                sys.exit(1)

            print("\n✅ Canary safety checks passed")
        else:
            print("⚠️  Could not scrape metrics — proceeding with caution")

    # Update manifest.yaml mode in place
    with open("manifest.yaml", "r") as f:
        content = f.read()
    updated = re.sub(
        r"(^\s*mode:\s*).*$",
        f"\\g<1>{target_mode}",
        content,
        flags=re.MULTILINE
    )
    with open("manifest.yaml", "w") as f:
        f.write(updated)
    print(f"✅ Updated manifest.yaml mode → {target_mode}")

    # Regenerate docker-compose.yml
    manifest = load_manifest()
    compose = render_template("templates/docker-compose.yml.j2", manifest)
    with open("docker-compose.yml", "w") as f:
        f.write(compose)
    print("✅ Regenerated docker-compose.yml")

    # Restart app only
    print("🔄 Restarting app container only...")
    run("docker compose up -d --no-deps app")
    time.sleep(5)

    # Confirm via healthz
    result = run(
        f"curl -s http://localhost:{nginx_port}/healthz",
        check=False
    )
    if result.returncode == 0:
        print(f"✅ Service responding after promote")
        print(f"   /healthz: {result.stdout.strip()}")
    else:
        print("❌ Service not responding after promote")
        sys.exit(1)

    # Record in audit trail
    append_history("promote_success", {"mode": target_mode})

    print(f"\n✅ Promote complete — now running in {target_mode} mode")

