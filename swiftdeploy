def cmd_status():
    """
    Live-refreshing terminal dashboard.
    Shows metrics + policy compliance.
    Appends every scrape to history.jsonl.
    """
    print_step("swiftdeploy status — live dashboard (Ctrl+C to exit)")
    manifest = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    opa_port = manifest["opa"]["port"]

    try:
        while True:
            # Clear terminal
            os.system("clear")

            now = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")
            print(f"{'─'*50}")
            print(f"  SwiftDeploy Status Dashboard — {now}")
            print(f"{'─'*50}")

            # Scrape metrics
            metrics_text = scrape_metrics(nginx_port)

            if not metrics_text:
                print("\n  ⚠️  Cannot reach app — is the stack running?")
                print("  Run: ./swiftdeploy deploy")
            else:
                # Calculate values
                error_rate = calculate_error_rate(metrics_text)
                p99_latency = calculate_p99_latency(metrics_text)

                # Get mode and chaos state
                app_mode = parse_counter(metrics_text, "app_mode")
                chaos_val = parse_counter(metrics_text, "chaos_active")
                uptime = parse_counter(metrics_text, "app_uptime_seconds")

                mode_str = "canary" if app_mode == 1 else "stable"
                chaos_str = {0: "none", 1: "slow", 2: "error"}.get(
                    int(chaos_val), "unknown"
                )

                print(f"\n  📊 Metrics")
                print(f"    Mode:         {mode_str}")
                print(f"    Uptime:       {uptime:.0f}s")
                print(f"    Error rate:   {error_rate*100:.2f}%")
                print(f"    P99 latency:  {p99_latency:.0f}ms")
                print(f"    Chaos state:  {chaos_str}")

                # Policy compliance check
                print(f"\n  🔐 Policy Compliance")

                # Infrastructure check
                try:
                    host_stats = get_host_stats()
                    infra_decision = query_opa(
                        opa_port,
                        "policy/infrastructure",
                        host_stats
                    )
                    if infra_decision.get("allow"):
                        print(f"    ✅ Infrastructure policy: PASS")
                    else:
                        print(f"    ❌ Infrastructure policy: FAIL")
                        for v in infra_decision.get("violations", []):
                            print(f"       → {v}")
                except Exception:
                    print(f"    ⚠️  Infrastructure policy: UNAVAILABLE")

                # Canary check
                canary_decision = query_opa(
                    opa_port,
                    "policy/canary",
                    {
                        "error_rate": error_rate,
                        "p99_latency_ms": p99_latency,
                        "timestamp": datetime.datetime.utcnow().isoformat() + "Z"
                    }
                )
                if canary_decision.get("error") == "opa_unreachable":
                    print(f"    ⚠️  Canary policy: OPA UNREACHABLE")
                elif canary_decision.get("allow"):
                    print(f"    ✅ Canary policy: PASS")
                else:
                    print(f"    ❌ Canary policy: FAIL")
                    for v in canary_decision.get("violations", []):
                        print(f"       → {v}")

                # Append to audit trail
                append_history("status_scrape", {
                    "error_rate": error_rate,
                    "p99_latency_ms": p99_latency,
                    "mode": mode_str,
                    "chaos": chaos_str,
                    "uptime": uptime
                })

            print(f"\n  Refreshing every 5s — Ctrl+C to exit")
            time.sleep(5)

    except KeyboardInterrupt:
        print("\n\n  Dashboard stopped.")

